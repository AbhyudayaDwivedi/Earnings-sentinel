# --- CELL 19: Figure out the prior quarter automatically ---
def get_prior_quarter(year, quarter):
    """Given a fiscal year/quarter, returns the (year, quarter) immediately before it."""
    if quarter == 1:
        return year - 1, 4
    return year, quarter - 1

